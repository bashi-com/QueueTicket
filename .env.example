DATABASE_URL=postgres://postgres:password@localhost:5432/queueticket
ADMIN_PASSWORD=change-this-password
BASE_URL=http://localhost:8000
PORT=8000
BIND_ADDR=0.0.0.0

# Docker Compose 用（ADMIN_PASSWORD / BASE_URL は上記を共用）
# 接続URLにそのまま使うため、DBのユーザー名・DB名・パスワードは英数字と _ - にする。
POSTGRES_USER=queueticket
POSTGRES_DB=queueticket
POSTGRES_PASSWORD=change-this-db-password
APP_PORT=8000
# --profile tunnel を使う場合のみ設定
TUNNEL_TOKEN=
# Compose は DATABASE_URL を db サービス宛てに組み立て、PORT=8000 / BIND_ADDR=0.0.0.0 を設定する。
